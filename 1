// ============================================
// RECOMMENDATION ENGINE
// ============================================

function getRecommendations(score){

    // SORT THE ENTIRE DATABASE
    // BASED ON DISTANCE TO CLIENT SCORE

    const sortedStocks =

    [...EXPANDED_STOCK_POOL]

    .sort((a,b)=>{

        return Math.abs(
            a.fundamentalscore - score
        )

        -

        Math.abs(
            b.fundamentalscore - score
        );

    });

    // RETURN TOP 5

    return sortedStocks.slice(0,5);

}
